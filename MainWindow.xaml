<Window x:Class="Fassadenplaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fassadenplaner"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#EEF2F5">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#71808C"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD4DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#243746"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ToolTileButton" TargetType="Button">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="Foreground" Value="#263845"/>
            <Setter Property="BorderBrush" Value="#D5DEE5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#83919C"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D5DDE4"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Fassadenplaner"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#18242E"/>
                    <TextBlock Text="Visuell planen statt Maße suchen"
                               Margin="0,3,0,0"
                               FontSize="11.5"
                               Foreground="#7A8893"/>
                </StackPanel>

                <!-- Gauben-Werkzeug -->
                <Button x:Name="DormerToolButton"
                        Grid.Column="1"
                        Style="{StaticResource ToolTileButton}"
                        Margin="8,0,8,0"
                        Click="DormerTool_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Canvas Width="52" Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Polygon Points="5,31 15,16 37,16 47,31"
                                     Fill="#E8EDF1"
                                     Stroke="#263845"
                                     StrokeThickness="2"/>
                            <Polyline Points="15,16 15,9 37,9 37,16"
                                      Stroke="#263845"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round"/>
                            <Line X1="5" Y1="31" X2="47" Y2="31"
                                  Stroke="#263845"
                                  StrokeThickness="2"/>
                        </Canvas>

                        <TextBlock Grid.Row="1"
                                   Text="Gaube"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Button>

                <!-- Coil-Werkzeug -->
                <Button x:Name="CladdingToolButton"
                        Grid.Column="2"
                        Style="{StaticResource ToolTileButton}"
                        Margin="0,0,8,0"
                        Click="CladdingTool_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Canvas Width="58" Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Ellipse Width="31" Height="31"
                                     Canvas.Left="4" Canvas.Top="4"
                                     Fill="#E8EDF1"
                                     Stroke="#263845"
                                     StrokeThickness="2"/>
                            <Ellipse Width="13" Height="13"
                                     Canvas.Left="13" Canvas.Top="13"
                                     Fill="White"
                                     Stroke="#263845"
                                     StrokeThickness="2"/>
                            <Path Data="M 34,9 C 47,9 52,14 52,22 L 52,33 L 29,33"
                                  Stroke="#263845"
                                  StrokeThickness="2"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round"/>
                            <Line X1="29" Y1="33" X2="50" Y2="33"
                                  Stroke="#263845"
                                  StrokeThickness="2"/>
                        </Canvas>

                        <TextBlock Grid.Row="1"
                                   Text="Bekleidung"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Button>

                <!-- Scharen-Werkzeug -->
                <Button x:Name="SeamToolButton"
                        Grid.Column="3"
                        Style="{StaticResource ToolTileButton}"
                        Margin="0,0,8,0"
                        Click="SeamTool_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Canvas Width="58" Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Polygon Points="8,34 15,8 49,8 42,34"
                                     Fill="#E8EDF1"
                                     Stroke="#263845"
                                     StrokeThickness="1.6"/>
                            <Line X1="20" Y1="8" X2="16" Y2="34"
                                  Stroke="#31566B"
                                  StrokeThickness="1.8"/>
                            <Line X1="30" Y1="8" X2="27" Y2="34"
                                  Stroke="#31566B"
                                  StrokeThickness="1.8"/>
                            <Line X1="40" Y1="8" X2="38" Y2="34"
                                  Stroke="#31566B"
                                  StrokeThickness="1.8"/>
                        </Canvas>

                        <TextBlock Grid.Row="1"
                                   Text="Scharen"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </Button>

                <!-- Updatebereich -->
                <StackPanel Grid.Column="5"
                            VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PROGRAMM"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#83919C"/>
                            <TextBlock x:Name="InstalledVersionText"
                                       Text="Installiert: –"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#6F7E89"/>
                        </StackPanel>
                        <Button x:Name="CheckUpdatesButton"
                                Grid.Column="1"
                                Content="Updates prüfen"
                                Height="32"
                                Padding="11,0"
                                Click="CheckForUpdates_Click"/>
                    </Grid>
                    <TextBlock x:Name="UpdateStatusText"
                               Text="Noch nicht geprüft."
                               Margin="0,5,0,0"
                               FontSize="10.5"
                               Foreground="#82909A"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="InstallUpdateButton"
                            Content="Update installieren"
                            Height="30"
                            Margin="0,6,0,0"
                            Visibility="Collapsed"
                            Click="InstallUpdate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Arbeitsbereich -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 3D-Viewer -->
            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Background="White"
                    BorderBrush="#D7DEE5"
                    BorderThickness="1"
                    CornerRadius="11">
                <Grid x:Name="ViewportHost"
                      Background="Transparent"
                      PreviewMouseWheel="ViewportHost_PreviewMouseWheel"
                      PreviewMouseLeftButtonDown="ViewportHost_PreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="ViewportHost_PreviewMouseLeftButtonUp"
                      PreviewMouseRightButtonDown="ViewportHost_PreviewMouseRightButtonDown"
                      PreviewMouseRightButtonUp="ViewportHost_PreviewMouseRightButtonUp"
                      PreviewMouseMove="ViewportHost_PreviewMouseMove">

                    <Viewport3D x:Name="DormerViewport"
                                Margin="8"
                                ClipToBounds="True">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="DormerCamera"
                                               Position="8,5,10"
                                               LookDirection="-8,-4,-10"
                                               UpDirection="0,1,0"
                                               FieldOfView="34"/>
                        </Viewport3D.Camera>
                    </Viewport3D>

                    <Canvas x:Name="DimensionOverlay"
                            Margin="8"
                            Panel.ZIndex="5"/>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="18"
                            Padding="12,8"
                            CornerRadius="7"
                            Background="#EEFFFFFF"
                            BorderBrush="#DCE3E8"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="3D-Gaube"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#243440"/>
                            <TextBlock Text="Maße direkt an den Kanten"
                                       Margin="0,2,0,0"
                                       FontSize="10.5"
                                       Foreground="#7B8892"/>
                        </StackPanel>
                    </Border>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="18"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#F4F7F9"
                            BorderBrush="#DCE3E8"
                            BorderThickness="1">
                        <TextBlock Text="Rad: Zoom · Links: Orbit · Rechts: Verschieben"
                                   FontSize="10.5"
                                   Foreground="#78858F"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Rechte kontextabhängige Seitenleiste -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#D7DEE5"
                    BorderThickness="1"
                    CornerRadius="11">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">

                        <TextBlock x:Name="ToolPanelTitle"
                                   Text="Gaube"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E2B35"/>
                        <TextBlock x:Name="ToolPanelSubtitle"
                                   Text="Geometrie, Maße und Flächen"
                                   Margin="0,2,0,10"
                                   FontSize="10.5"
                                   Foreground="#80909B"/>

                        <!-- GAUBEN-EIGENSCHAFTEN -->
                        <StackPanel x:Name="DormerPropertiesPanel">

                            <TextBlock Text="GAUBENFORM"
                                       Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="DormerTypeCombo"
                                      Margin="0,4,0,9"
                                      SelectedIndex="0"
                                      SelectionChanged="DormerTypeCombo_SelectionChanged">
                                <ComboBoxItem Content="Flachdachgaube"/>
                                <ComboBoxItem Content="Satteldachgaube mit Giebel"/>
                                <ComboBoxItem Content="Schleppdachgaube"/>
                            </ComboBox>

                            <TextBlock Text="HAUPTDACHNEIGUNG"
                                       Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,4,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RoofPitchBox"
                                         Grid.Column="0"
                                         Text="35"
                                         PreviewKeyDown="RoofPitchBox_PreviewKeyDown"/>
                                <TextBlock Grid.Column="1"
                                           Text="°"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#6E7A86"/>
                                <Button Grid.Column="2"
                                        Content="Übernehmen"
                                        Margin="4,0,0,0"
                                        Click="ApplyRoofPitch_Click"/>
                            </Grid>

                            <StackPanel x:Name="DormerPitchPanel"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,9">
                                <TextBlock Text="GAUBENDACHNEIGUNG"
                                           Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DormerPitchBox"
                                             Grid.Column="0"
                                             Text="10"
                                             PreviewKeyDown="DormerPitchBox_PreviewKeyDown"/>
                                    <TextBlock Grid.Column="1"
                                               Text="°"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="#6E7A86"/>
                                    <Button Grid.Column="2"
                                            Content="Übernehmen"
                                            Margin="4,0,0,0"
                                            Click="ApplyDormerPitch_Click"/>
                                </Grid>
                            </StackPanel>

                            <Border Background="#F5F7F9"
                                    BorderBrush="#DDE4E9"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="AUSGEWÄHLTE KANTE"
                                               Style="{StaticResource SectionTitle}"/>

                                    <TextBlock x:Name="SelectedDimensionTitle"
                                               Text="Gaubenbreite"
                                               Margin="0,3,0,2"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#1D2B36"/>

                                    <TextBlock x:Name="SelectedDimensionHint"
                                               Text="Horizontale Kante der Gaubenfront"
                                               Margin="0,0,0,7"
                                               FontSize="10.5"
                                               Foreground="#7B8792"
                                               TextWrapping="Wrap"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DimensionValueBox"
                                                 Grid.Column="0"
                                                 Text="300"
                                                 PreviewKeyDown="DimensionValueBox_PreviewKeyDown"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="cm"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="#6E7A86"/>
                                    </Grid>

                                    <Button Content="Maß übernehmen"
                                            Margin="0,7,0,0"
                                            Height="32"
                                            Click="ApplyDimension_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="AKTUELLE MAẞE"
                                       Style="{StaticResource LabelStyle}"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition x:Name="ShedPitchRow" Height="0"/>
                                    <RowDefinition x:Name="GableRow" Height="0"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Breite" Foreground="#586672"/>
                                <TextBlock x:Name="WidthValueText" Grid.Row="0" Grid.Column="1" Text="300 cm" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Text="Front-Wandhöhe" Foreground="#586672"/>
                                <TextBlock x:Name="HeightValueText" Grid.Row="1" Grid.Column="1" Text="160 cm" FontWeight="SemiBold"/>

                                <TextBlock x:Name="DepthLabel" Grid.Row="2" Text="Gaubentiefe" Foreground="#586672"/>
                                <TextBlock x:Name="DepthValueText" Grid.Row="2" Grid.Column="1" Text="228,5 cm" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="3" Text="Untere Wangenlänge" Foreground="#586672"/>
                                <TextBlock x:Name="SlopeValueText" Grid.Row="3" Grid.Column="1" Text="279 cm" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="4" Text="Hauptdachneigung" Foreground="#586672"/>
                                <TextBlock x:Name="PitchValueText" Grid.Row="4" Grid.Column="1" Text="35°" FontWeight="SemiBold"/>

                                <TextBlock x:Name="DormerPitchLabel" Grid.Row="5" Text="Gaubendachneigung" Foreground="#586672" Visibility="Collapsed"/>
                                <TextBlock x:Name="DormerPitchValueText" Grid.Row="5" Grid.Column="1" Text="10°" FontWeight="SemiBold" Visibility="Collapsed"/>

                                <TextBlock x:Name="GableLabel" Grid.Row="6" Text="Giebelhöhe" Foreground="#586672" Visibility="Collapsed"/>
                                <TextBlock x:Name="GableValueText" Grid.Row="6" Grid.Column="1" Text="80 cm" FontWeight="SemiBold" Visibility="Collapsed"/>
                            </Grid>

                            <Border Height="1"
                                    Background="#E3E8EC"
                                    Margin="0,10,0,10"/>

                            <Border x:Name="SurfaceDetailPanel"
                                    Height="195"
                                    Padding="8"
                                    CornerRadius="9"
                                    Background="#F8FAFB"
                                    BorderBrush="#D4DDE4"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="SurfaceDetailTitle"
                                               Grid.Row="0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#243440"/>

                                    <Canvas x:Name="SurfaceDetailCanvas"
                                            Grid.Row="1"
                                            Margin="0,7,0,5"
                                            Background="Transparent"/>

                                    <TextBlock x:Name="SurfaceDetailAreaText"
                                               Grid.Row="2"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#243440"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- BEKLEIDUNGS-/COIL-EIGENSCHAFTEN -->
                        <StackPanel x:Name="CladdingPropertiesPanel"
                                    Visibility="Collapsed">

                            <Border Background="#F7F9FB"
                                    BorderBrush="#DDE4E9"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="28"
                                            Height="28"
                                            CornerRadius="14"
                                            Background="#E7F0F5"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="◉"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="#31566B"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Material"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#53636F"/>
                                        <ComboBox x:Name="CladdingMaterialCombo"
                                                  Height="32"
                                                  Margin="0,4,0,0"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Titanzink"/>
                                            <ComboBoxItem Content="Aluminium"/>
                                            <ComboBoxItem Content="Kupfer"/>
                                            <ComboBoxItem Content="Edelstahl"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#F7F9FB"
                                    BorderBrush="#DDE4E9"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="Herstellung"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#53636F"/>

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <RadioButton x:Name="ManualProfileRadio"
                                                     Grid.Column="0"
                                                     GroupName="CladdingMode"
                                                     IsChecked="True"
                                                     Checked="CladdingMode_Checked"
                                                     VerticalContentAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="✋  Handgekantet"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334753"/>
                                                <TextBlock Text="Deckmaß selbst eingeben"
                                                           FontSize="9"
                                                           Foreground="#87939C"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="MachineProfileRadio"
                                                     Grid.Column="2"
                                                     GroupName="CladdingMode"
                                                     Checked="CladdingMode_Checked"
                                                     VerticalContentAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="⚙  Maschinell"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334753"/>
                                                <TextBlock Text="Deckmaß automatisch"
                                                           FontSize="9"
                                                           Foreground="#87939C"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <TextBlock x:Name="CladdingModeHintText"
                                               Text="Handgekantet · tatsächliche Deckbreite selbst eintragen"
                                               Margin="0,6,0,0"
                                               FontSize="9.5"
                                               Foreground="#7D8992"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Expander x:Name="ManualFoldDetailsExpander"
                                      Header="Falzmaße optional"
                                      Visibility="Visible"
                                      IsExpanded="False"
                                      Margin="0,0,0,9"
                                      Foreground="#53636F">
                                <Border Background="#F7F9FB"
                                        BorderBrush="#DDE4E9"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,5,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Nur wenn du über die Falzzugaben rechnen willst."
                                                   FontSize="10"
                                                   Foreground="#6F7E89"
                                                   TextWrapping="Wrap"/>

                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Oberfalz"
                                                           FontSize="9.5"
                                                           Foreground="#7D8992"/>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ManualUpperFoldBox"
                                                             Height="32"
                                                             Text="45"
                                                             TextChanged="ManualFoldValue_TextChanged"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="mm"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#6E7A86"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Unterfalz"
                                                           FontSize="9.5"
                                                           Foreground="#7D8992"/>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ManualLowerFoldBox"
                                                             Height="32"
                                                             Text="35"
                                                             TextChanged="ManualFoldValue_TextChanged"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="mm"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#6E7A86"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="#EEF4F7"
                                                CornerRadius="6"
                                                Padding="8"
                                                Margin="0,7,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
