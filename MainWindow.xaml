<Window x:Class="Fassadenplaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fassadenplaner"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#EEF2F5">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#71808C"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD4DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#243746"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="RibbonCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#778691"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Oberes Menüband -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D5DDE4"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="255"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="255"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="245"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Fassadenplaner"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#18242E"/>
                    <TextBlock Text="Gauben · Fassaden · Blechplanung"
                               Margin="0,3,0,0"
                               FontSize="11.5"
                               Foreground="#7A8893"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Background="#E1E6EA"
                        Margin="0,3"/>

                <StackPanel Grid.Column="2"
                            Margin="18,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="GAUBENFORM" Style="{StaticResource RibbonCaption}"/>
                    <ComboBox x:Name="DormerTypeCombo"
                              SelectedIndex="0"
                              SelectionChanged="DormerTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="Flachdachgaube"/>
                        <ComboBoxItem Content="Satteldachgaube mit Giebel"/>
                        <ComboBoxItem Content="Schleppdachgaube"/>
                    </ComboBox>
                </StackPanel>

                <Border Grid.Column="3"
                        Width="1"
                        Background="#E1E6EA"
                        Margin="0,3"/>

                <StackPanel Grid.Column="4"
                            Margin="18,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="HAUPTDACHNEIGUNG" Style="{StaticResource RibbonCaption}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RoofPitchBox"
                                 Grid.Column="0"
                                 Text="35"
                                 PreviewKeyDown="RoofPitchBox_PreviewKeyDown"/>
                        <TextBlock Grid.Column="1"
                                   Text="°"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="#6E7A86"/>
                        <Button Grid.Column="2"
                                Content="Übernehmen"
                                Margin="4,0,0,0"
                                Click="ApplyRoofPitch_Click"/>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="5"
                        Width="1"
                        Background="#E1E6EA"
                        Margin="0,3"/>

                <StackPanel x:Name="DormerPitchPanel"
                            Grid.Column="6"
                            Margin="18,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="GAUBENDACHNEIGUNG" Style="{StaticResource RibbonCaption}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DormerPitchBox"
                                 Grid.Column="0"
                                 Text="10"
                                 PreviewKeyDown="DormerPitchBox_PreviewKeyDown"/>
                        <TextBlock Grid.Column="1"
                                   Text="°"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="#6E7A86"/>
                        <Button Grid.Column="2"
                                Content="Übernehmen"
                                Margin="4,0,0,0"
                                Click="ApplyDormerPitch_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="8"
                            VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PROGRAMM"
                                       Style="{StaticResource RibbonCaption}"/>
                            <TextBlock x:Name="InstalledVersionText"
                                       Text="Installiert: –"
                                       FontSize="11"
                                       Foreground="#6F7E89"/>
                        </StackPanel>
                        <Button x:Name="CheckUpdatesButton"
                                Grid.Column="1"
                                Content="Updates prüfen"
                                Height="32"
                                Padding="11,0"
                                Click="CheckForUpdates_Click"/>
                    </Grid>
                    <TextBlock x:Name="UpdateStatusText"
                               Text="Noch nicht geprüft."
                               Margin="0,5,0,0"
                               FontSize="10.5"
                               Foreground="#82909A"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="InstallUpdateButton"
                            Content="Update installieren"
                            Height="30"
                            Margin="0,6,0,0"
                            Visibility="Collapsed"
                            Click="InstallUpdate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Arbeitsbereich -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="332"/>
            </Grid.ColumnDefinitions>

            <!-- Großer 3D-Arbeitsbereich -->
            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Background="White"
                    BorderBrush="#D7DEE5"
                    BorderThickness="1"
                    CornerRadius="11">
                <Grid x:Name="ViewportHost"
                      Background="Transparent"
                      PreviewMouseWheel="ViewportHost_PreviewMouseWheel"
                      PreviewMouseLeftButtonDown="ViewportHost_PreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="ViewportHost_PreviewMouseLeftButtonUp"
                      PreviewMouseRightButtonDown="ViewportHost_PreviewMouseRightButtonDown"
                      PreviewMouseRightButtonUp="ViewportHost_PreviewMouseRightButtonUp"
                      PreviewMouseMove="ViewportHost_PreviewMouseMove">

                    <Viewport3D x:Name="DormerViewport"
                                Margin="8"
                                ClipToBounds="True">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="DormerCamera"
                                               Position="8,5,10"
                                               LookDirection="-8,-4,-10"
                                               UpDirection="0,1,0"
                                               FieldOfView="34"/>
                        </Viewport3D.Camera>
                    </Viewport3D>

                    <Canvas x:Name="DimensionOverlay"
                            Margin="8"
                            Panel.ZIndex="5"/>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="18"
                            Padding="12,8"
                            CornerRadius="7"
                            Background="#EEFFFFFF"
                            BorderBrush="#DCE3E8"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="3D-Gaube"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#243440"/>
                            <TextBlock Text="Maße direkt an den Kanten"
                                       Margin="0,2,0,0"
                                       FontSize="10.5"
                                       Foreground="#7B8892"/>
                        </StackPanel>
                    </Border>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="18"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="#F4F7F9"
                            BorderBrush="#DCE3E8"
                            BorderThickness="1">
                        <TextBlock Text="Rad: Zoom · Links: Orbit · Rechts: Verschieben"
                                   FontSize="10.5"
                                   Foreground="#78858F"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Rechte Info-/Eigenschaftenleiste -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#D7DEE5"
                    BorderThickness="1"
                    CornerRadius="11">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">

                        <TextBlock Text="Eigenschaften"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1E2B35"/>
                        <TextBlock Text="Kontextbezogene Maße und Flächen"
                                   Margin="0,3,0,16"
                                   FontSize="11"
                                   Foreground="#80909B"/>

                        <Border Background="#F5F7F9"
                                BorderBrush="#DDE4E9"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="AUSGEWÄHLTE KANTE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#83919C"/>

                                <TextBlock x:Name="SelectedDimensionTitle"
                                           Text="Gaubenbreite"
                                           Margin="0,4,0,3"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1D2B36"/>

                                <TextBlock x:Name="SelectedDimensionHint"
                                           Text="Horizontale Kante der Gaubenfront"
                                           Margin="0,0,0,11"
                                           FontSize="11"
                                           Foreground="#7B8792"
                                           TextWrapping="Wrap"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DimensionValueBox"
                                             Grid.Column="0"
                                             Text="300"
                                             PreviewKeyDown="DimensionValueBox_PreviewKeyDown"/>
                                    <TextBlock Grid.Column="1"
                                               Text="cm"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="#6E7A86"/>
                                </Grid>

                                <Button Content="Maß übernehmen"
                                        Margin="0,10,0,0"
                                        Click="ApplyDimension_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="AKTUELLE MAẞE"
                                   Style="{StaticResource LabelStyle}"/>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition x:Name="ShedPitchRow" Height="0"/>
                                <RowDefinition x:Name="GableRow" Height="0"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Breite" Foreground="#586672"/>
                            <TextBlock x:Name="WidthValueText" Grid.Row="0" Grid.Column="1" Text="300 cm" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Text="Front-Wandhöhe" Foreground="#586672"/>
                            <TextBlock x:Name="HeightValueText" Grid.Row="1" Grid.Column="1" Text="160 cm" FontWeight="SemiBold"/>

                            <TextBlock x:Name="DepthLabel" Grid.Row="2" Text="Gaubentiefe" Foreground="#586672"/>
                            <TextBlock x:Name="DepthValueText" Grid.Row="2" Grid.Column="1" Text="228,5 cm" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="3" Text="Untere Wangenlänge" Foreground="#586672"/>
                            <TextBlock x:Name="SlopeValueText" Grid.Row="3" Grid.Column="1" Text="279 cm" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="4" Text="Hauptdachneigung" Foreground="#586672"/>
                            <TextBlock x:Name="PitchValueText" Grid.Row="4" Grid.Column="1" Text="35°" FontWeight="SemiBold"/>

                            <TextBlock x:Name="DormerPitchLabel" Grid.Row="5" Text="Gaubendachneigung" Foreground="#586672" Visibility="Collapsed"/>
                            <TextBlock x:Name="DormerPitchValueText" Grid.Row="5" Grid.Column="1" Text="10°" FontWeight="SemiBold" Visibility="Collapsed"/>

                            <TextBlock x:Name="GableLabel" Grid.Row="6" Text="Giebelhöhe" Foreground="#586672" Visibility="Collapsed"/>
                            <TextBlock x:Name="GableValueText" Grid.Row="6" Grid.Column="1" Text="80 cm" FontWeight="SemiBold" Visibility="Collapsed"/>
                        </Grid>

                        <Border Height="1"
                                Background="#E3E8EC"
                                Margin="0,15,0,15"/>

                        <!-- 2D-Flächenansicht jetzt fest in der rechten Leiste -->
                        <Border x:Name="SurfaceDetailPanel"
                                Height="245"
                                Padding="10"
                                CornerRadius="9"
                                Background="#F8FAFB"
                                BorderBrush="#D4DDE4"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="SurfaceDetailTitle"
                                           Grid.Row="0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#243440"/>

                                <Canvas x:Name="SurfaceDetailCanvas"
                                        Grid.Row="1"
                                        Margin="0,7,0,5"
                                        Background="Transparent"/>

                                <TextBlock x:Name="SurfaceDetailAreaText"
                                           Grid.Row="2"
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#243440"/>
                            </Grid>
                        </Border>

                        <Border Background="#F8FAFB"
                                BorderBrush="#E0E6EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11"
                                Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="3D-Steuerung"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#61717D"/>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="10.5"
                                           LineHeight="17"
                                           Foreground="#7D8A94"
                                           TextWrapping="Wrap"
                                           Text="Mausrad: zoomen&#10;Linke Maustaste: rotieren&#10;Rechte Maustaste: verschieben&#10;Kurzer Linksklick: Kante oder Fläche auswählen"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
